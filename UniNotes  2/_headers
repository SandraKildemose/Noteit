/*
  # Forhindrer clickjacking
  X-Frame-Options: DENY

  # Forhindrer MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Referrer policy — ingen lækage af URL til 3. part
  Referrer-Policy: strict-origin-when-cross-origin

  # Forhindrer browseren i at sende permissions uden explicit samtykke
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()

  # HSTS — tvinger HTTPS i 1 år
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https: wss://*.supabase.co; worker-src 'self'; frame-ancestors 'none';

  # XSS beskyttelse (ældre browsere)
  X-XSS-Protection: 1; mode=block
